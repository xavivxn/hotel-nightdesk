{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Love Nestt Motel App",
  "version": "0.1.0",
  "identifier": "com.nightdesk.hotel",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Love Nestt Motel App",
        "width": 1680,
        "height": 1050,
        "minWidth": 1100,
        "minHeight": 820,
        "center": true,
        "maximized": false,
        "decorations": false,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
