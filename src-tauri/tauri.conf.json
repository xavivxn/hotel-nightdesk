{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Love Nestt Motel App",
  "version": "0.1.16",
  "identifier": "com.nightdesk.hotel",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "node node_modules/typescript/bin/tsc && node node_modules/vite/bin/vite.js build --configLoader runner",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Love Nestt Motel App",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 600,
        "center": true,
        "visible": false,
        "maximized": false,
        "decorations": false,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEIwMzFFRUI4NDMxRTlBMkQKUldRdG1oNUR1TzR4c05mWkpEenY4NU5XbUwvKzAwOGowaHRHWVJGcmgrVmxDUWttVU1FSUtZeHoK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
